{
  "scan_plan": "capradar 0.1.0",
  "date": "2026-10-30",
  "top": 10,
  "lanes": [
    {
      "id": "skills",
      "label": "Skills"
    },
    {
      "id": "plugins_connectors",
      "label": "Plugins / Connectors"
    },
    {
      "id": "mcp",
      "label": "MCPs"
    },
    {
      "id": "agents",
      "label": "Agents / Persistent Workers"
    },
    {
      "id": "oss",
      "label": "GitHub / OSS Projects"
    },
    {
      "id": "models",
      "label": "Models / Native Features"
    },
    {
      "id": "research_search",
      "label": "Research / Search Tools"
    },
    {
      "id": "automation",
      "label": "Automation / Workflow Tools"
    }
  ],
  "profile": {
    "name": "Example: independent technical consultant (synthetic)",
    "jobs": [
      "research a technical or market question and produce a cited brief",
      "write clear explanations and client-ready documents from rough notes",
      "build and maintain small Python tools and scripts",
      "review pull requests and keep repositories tidy",
      "automate repetitive weekly admin (reports, file sorting, reminders)"
    ],
    "current_stack": [
      {
        "name": "Claude Pro",
        "category": "models",
        "covers": [
          "chat",
          "coding",
          "research mode",
          "projects"
        ]
      },
      {
        "name": "ChatGPT Plus",
        "category": "models",
        "covers": [
          "chat",
          "deep research",
          "image generation"
        ]
      },
      {
        "name": "Claude Code",
        "category": "agents",
        "covers": [
          "coding agent",
          "terminal",
          "git"
        ]
      },
      {
        "name": "GitHub",
        "category": "oss",
        "covers": [
          "repositories",
          "pull requests",
          "actions"
        ]
      },
      {
        "name": "Google Workspace",
        "category": "plugins_connectors",
        "covers": [
          "email",
          "calendar",
          "docs"
        ]
      }
    ],
    "constraints": [
      "budget: prefer free or already-paid tools; at most one new subscription under $25/month",
      "privacy: client material never goes to tools that train on inputs",
      "time: setup under one hour per tool"
    ]
  },
  "already_in_ledger": {
    "skills": [],
    "plugins_connectors": [],
    "mcp": [],
    "agents": [],
    "oss": [],
    "models": [],
    "research_search": [],
    "automation": []
  },
  "reverify": [],
  "workspace": "the folder given by --dir (default ./radar)",
  "write_candidates_to": "inbox/scan-2026-10-30.json",
  "candidate_contract": {
    "required": [
      "name",
      "category"
    ],
    "text_fields": [
      "job",
      "description",
      "cost",
      "privacy",
      "permissions",
      "reason",
      "version",
      "evidence_notes",
      "reverify_trigger",
      "maintenance_notes"
    ],
    "enum_fields": {
      "recommendation": [
        "USE",
        "TEST",
        "WATCH",
        "IGNORE"
      ],
      "improvement_opportunity": [
        "YES",
        "NO",
        "UNKNOWN"
      ],
      "benchmark_needed": [
        "YES",
        "NO",
        "UNKNOWN"
      ],
      "native_overlap": [
        "YES",
        "PARTIAL",
        "NO",
        "UNKNOWN"
      ],
      "evidence_quality": [
        "STRONG",
        "MODERATE",
        "WEAK",
        "ANECDOTAL",
        "UNKNOWN"
      ],
      "status": [
        "ACTIVE",
        "MAINTAINED",
        "PREVIEW",
        "STALE",
        "ARCHIVED",
        "DEPRECATED",
        "UNKNOWN"
      ]
    },
    "date_fields": [
      "last_activity",
      "last_verified",
      "reverify_after"
    ],
    "sources": {
      "url": "required",
      "tier": [
        "TIER1_OFFICIAL",
        "TIER2_ECOSYSTEM",
        "TIER3_PRACTICAL",
        "UNKNOWN"
      ],
      "type": [
        "docs",
        "changelog",
        "registry",
        "repo",
        "benchmark",
        "review",
        "news",
        "forum",
        "social",
        "other"
      ],
      "accessed": "YYYY-MM-DD"
    },
    "other": {
      "popularity": "object, e.g. {\"stars\": 1200, \"downloads\": \"UNKNOWN\"}",
      "aliases": "list of other names / wrappers / forks",
      "overlaps_with": "list of tools it duplicates",
      "duplicate_of": "name of the canonical candidate if this is a wrapper/fork",
      "current_tool": "{\"name\": ..., \"relation\": REPLACES|COMPLEMENTS|DUPLICATES|BEATS|LOSES_TO}",
      "repo": "the candidate's own repository URL, if any"
    },
    "rule": "Use UNKNOWN for anything you could not verify. Never guess."
  },
  "then_run": [
    "python -m capradar ingest <workspace>/inbox/scan-2026-10-30.json",
    "python -m capradar report --top 10",
    "python -m capradar reverify"
  ]
}
